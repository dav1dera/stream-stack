# Stream Stack - configurazione one-shot
#
# Non è obbligatorio modificare questo file a mano: ./setup.sh crea setup.env
# e chiede i valori mancanti. La GUI Windows genera lo stesso setup.env via SSH.
# setup.env è ignorato da Git e viene protetto con mode 0600.

# =============================================================================
# INSTALLAZIONE / RETE
# =============================================================================
BASE_DOMAIN=
SERVER_LAN_IP=
LAN_SUBNET=
TAILNET_DOMAIN=
PROXMOX_IP=
AMP_IP=
ALLOWED_EMAIL=
TIMEZONE=Europe/Rome

# Hostname pubblici opzionali. Vuoto = derivato da BASE_DOMAIN.
# Possono essere FQDN completamente diversi; NPM e i mapping interni vengono
# riallineati automaticamente.
AIOSTREAMS_HOST=
AIOMETADATA_HOST=
MEDIAFLOW_HOST=
EASYPROXY_HOST=
HEADSCALE_HOST=
STREAMVIX_HOST=
TVVOO_HOST=
AIOMANAGER_HOST=
SEANIME_HOST=
SEANIME_SHARED_HOST=
COMETNET_HOST=
STREMTHRU_HOST=
PORTAINER_HOST=

# =============================================================================
# NGINX PROXY MANAGER / HTTPS / READINESS
# =============================================================================
# NPM_ADMIN_EMAIL vuoto -> ALLOWED_EMAIL.
# NPM_ADMIN_PASSWORD vuoto -> generato automaticamente.
# LETSENCRYPT_EMAIL vuoto -> ALLOWED_EMAIL.
NPM_ADMIN_EMAIL=
NPM_ADMIN_PASSWORD=
LETSENCRYPT_EMAIL=
AUTO_CONFIGURE_NPM=true

# Il wizard Windows usa questi valori per la modalità one-click stretta.
# PUBLIC_READY_TIMEOUT controlla quanto aspettare DNS, TLS e servizi.
# Con STRICT_ACCEPTANCE=true il wizard non mostra "Completato" se i test
# end-to-end non passano. Per un fresh install inoltra TCP 80/443 prima.
PUBLIC_READY_TIMEOUT=600
STRICT_ACCEPTANCE=true

# =============================================================================
# LOGIN APPLICATIVI
# =============================================================================
AIO_USER=admin
AIO_PASSWORD=
AIO_CONFIG_ACCESS_KEY=
STREMTHRU_USER=admin
STREMTHRU_PASSWORD=
SEANIME_MAIN_PASSWORD=
SEANIME_SHARED_PASSWORD=

# =============================================================================
# CREDENZIALI ESTERNE / API KEY
# =============================================================================
CLOUDFLARE_API_TOKEN=

# Mullvad / WireGuard usato da Gluetun.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESS_CIDR=

TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TVDB_API_KEY=
TORBOX_API_KEY=

# Google OAuth usato da OAuth2 Proxy davanti a Headplane.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Integrazioni opzionali.
MDBLIST_API_KEY=
GEMINI_API_KEY=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
GITHUB_USERNAME=
GITHUB_TOKEN=
AIOMETADATA_CONFIG_UUID=
AIO_TRUSTED_UUID=

# =============================================================================
# SEGRETI LOCALI GENERATI AUTOMATICAMENTE
# Lasciali vuoti salvo esigenze specifiche.
# =============================================================================
POSTGRES_PASSWORD=
AIOMETADATA_ADMIN_KEY=
AIOMETADATA_ADDON_PASSWORD=
AIO_SECRET_KEY=
COMET_ADMIN_PASSWORD=
COMET_CONFIG_PASSWORD=
COMET_PUBLIC_API_TOKEN=
COMETNET_API_KEY=
COMET_STREAM_PROXY_PASSWORD=
MEDIAFLOW_PASSWORD=
EASYPROXY_PASSWORD=
AIOMANAGER_ENCRYPTION_KEY=
HEADPLANE_COOKIE_SECRET=
OAUTH2_COOKIE_SECRET=
STREMTHRU_VAULT_SECRET=

# =============================================================================
# VALORI GENERATI A RUNTIME
# =============================================================================
HEADSCALE_USER=admin
HEADSCALE_API_KEY=
HEADSCALE_AUTHKEY=
JACKETT_API_KEY=

# true = avvia temporaneamente Gluetun + Headscale + Jackett per ottenere le
# rispettive chiavi durante una nuova installazione.
AUTO_RUNTIME_KEYS=true
