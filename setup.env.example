# stream-stack one-shot configuration
#
# Copying/editing this file is optional: ./setup.sh creates setup.env for you
# and asks interactively for missing required values.
#
# setup.env is gitignored and chmod 600 because it contains secrets.
# Leave the AUTO-GENERATED fields blank: setup.sh will create strong values.
# Runtime-generated Jackett/Headscale keys may also stay blank; setup.sh will
# start only those bootstrap services and try to obtain them automatically.

# =============================================================================
# INSTALLATION / NETWORK
# =============================================================================
BASE_DOMAIN=
SERVER_LAN_IP=
LAN_SUBNET=
TAILNET_DOMAIN=
PROXMOX_IP=
AMP_IP=
ALLOWED_EMAIL=
TIMEZONE=Europe/Rome

# Optional hostname overrides. Blank = derive from BASE_DOMAIN.
AIOSTREAMS_HOST=
AIOMETADATA_HOST=
MEDIAFLOW_HOST=
HEADSCALE_HOST=
STREAMVIX_HOST=
SEANIME_HOST=
SEANIME_SHARED_HOST=
COMETNET_HOST=
STREMTHRU_HOST=
PORTAINER_HOST=
JACKETTIO_HOST=

# =============================================================================
# USER-FACING LOCAL LOGINS
# =============================================================================
AIO_USER=admin
AIO_PASSWORD=
AIO_CONFIG_ACCESS_KEY=
STREMTHRU_USER=admin
STREMTHRU_PASSWORD=
SEANIME_MAIN_PASSWORD=
SEANIME_SHARED_PASSWORD=

# =============================================================================
# EXTERNAL CREDENTIALS / API KEYS
# =============================================================================
CLOUDFLARE_API_TOKEN=

# Mullvad / WireGuard values used by Gluetun.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESS_CIDR=

TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TVDB_API_KEY=
TORBOX_API_KEY=

# Google OAuth client used by OAuth2 Proxy in front of Headplane.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional integrations. Leave blank if unused.
MDBLIST_API_KEY=
GEMINI_API_KEY=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
GITHUB_USERNAME=
GITHUB_TOKEN=
AIOMETADATA_CONFIG_UUID=
AIO_TRUSTED_UUID=

# =============================================================================
# AUTO-GENERATED LOCAL SECRETS
# Leave blank unless you deliberately want to choose your own.
# =============================================================================
POSTGRES_PASSWORD=
AIOMETADATA_ADMIN_KEY=
AIOMETADATA_ADDON_PASSWORD=
AIO_SECRET_KEY=
COMET_ADMIN_PASSWORD=
COMET_CONFIG_PASSWORD=
COMET_PUBLIC_API_TOKEN=
COMETNET_API_KEY=
COMET_STREAM_PROXY_PASSWORD=
MEDIAFLOW_PASSWORD=
HEADPLANE_COOKIE_SECRET=
OAUTH2_COOKIE_SECRET=
STREMTHRU_VAULT_SECRET=

# =============================================================================
# RUNTIME-GENERATED VALUES
# Leave blank on a fresh install. setup.sh can create/discover these.
# =============================================================================
HEADSCALE_USER=admin
HEADSCALE_API_KEY=
HEADSCALE_AUTHKEY=
JACKETT_API_KEY=

# true = start only Gluetun + Headscale + Jackett during setup to obtain their
# generated keys. Set false if you want to provide those three values yourself.
AUTO_RUNTIME_KEYS=true
