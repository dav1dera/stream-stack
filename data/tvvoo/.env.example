PORT=5000

# Vavoo
VAVOO_BOOT_REFRESH=1
VAVOO_SCHEDULE_REFRESH=1
VAVOO_REFRESH_COUNTRIES=it
VAVOO_DEBUG=1

# EasyProxy per il playback
PROXY_ENABLED=true
PROXY_BASE_URL=https://easyproxy.example.com
PROXY_PASSWORD=CHANGE_ME_EASYPROXY_PASSWORD
PROXY_PATH=/proxy/hls/manifest.m3u8

# Fallback Cloudflare Worker - disattivato come nel riferimento
VAVOO_WORKER_URL=
