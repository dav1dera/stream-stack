# Real secrets and local copies generated from templates
.env
**/.env
setup.env
**/allowed-emails.txt
**/userlist.txt
**/config.yaml
!**/config.yaml.example

# Persistent/runtime data
**/data/*.db
**/data/*.sqlite
**/data/*.sqlite-*
**/data/*.key
**/data/cache/
**/data/logs/
**/data/downloads/
**/data/anime/
**/data/manga/
**/data/offline/
**/data/state/
**/data/workdir/
**/data/letsencrypt/
**/data/Indexers/
**/data/cometnet/pools/
**/data/dmm_temp/
**/data/extensions/

# Common runtime artifacts
*.log
*.pid
*.bak

# Generated application configuration copied from public templates
**/config.toml
**/config.json
!**/config.toml.example
!**/config.json.example

# NPM desired state generated from setup.env
/data/npm/stream-stack-hosts.json

# Windows wizard local/build files
windows-wizard/.venv/
windows-wizard/.venv-build/
windows-wizard/build/
windows-wizard/dist/
windows-wizard/*.spec
windows-wizard/__pycache__/
